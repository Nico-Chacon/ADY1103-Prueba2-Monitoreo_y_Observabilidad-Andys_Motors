#!/bin/bash
# ---------------------------------------------------------------------------
# Stack de observabilidad PROPIO de Andys Motors (EP2 ADY1103).
#
# Levanta, en contenedores Docker, sobre esta instancia EC2:
#   - Prometheus      (recolecta y almacena las metricas, con rotacion de datos)
#   - Grafana         (visualiza; datasource y 2 dashboards ya aprovisionados)
#   - node_exporter   (sidecar: metricas del sistema operativo de esta maquina)
#
# Los archivos de configuracion nacen en el repositorio (infra/monitoring/) y
# Terraform los incrusta aqui, de modo que lo desplegado == lo versionado.
#
# Los logs de este script quedan en /var/log/cloud-init-output.log
# ---------------------------------------------------------------------------
set -euo pipefail

MON_DIR=/opt/monitoring
COMPOSE_VERSION=v2.29.7

# --- 1. Docker y Docker Compose ---------------------------------------------
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

CLI_PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$CLI_PLUGINS"
curl -fsSL --retry 5 --retry-delay 5 \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o "$CLI_PLUGINS/docker-compose"
chmod +x "$CLI_PLUGINS/docker-compose"

# --- 2. Archivos de configuracion -------------------------------------------
mkdir -p "$MON_DIR"/prometheus \
         "$MON_DIR"/grafana/provisioning/datasources \
         "$MON_DIR"/grafana/provisioning/dashboards \
         "$MON_DIR"/grafana/dashboards
cd "$MON_DIR"

cat > prometheus/prometheus.yml <<'ANDYS_EOF_PROMETHEUS'
${prometheus_yml}
ANDYS_EOF_PROMETHEUS

cat > docker-compose.yml <<'ANDYS_EOF_COMPOSE'
${docker_compose}
ANDYS_EOF_COMPOSE

cat > grafana/provisioning/datasources/datasource.yml <<'ANDYS_EOF_DATASOURCE'
${datasource_yml}
ANDYS_EOF_DATASOURCE

cat > grafana/provisioning/dashboards/dashboards.yml <<'ANDYS_EOF_PROVIDER'
${dashboards_yml}
ANDYS_EOF_PROVIDER

cat > grafana/dashboards/andys-tecnico.json <<'ANDYS_EOF_DASH1'
${dashboard_tecnico}
ANDYS_EOF_DASH1

cat > grafana/dashboards/andys-negocio.json <<'ANDYS_EOF_DASH2'
${dashboard_negocio}
ANDYS_EOF_DASH2

# Variables de Compose. La clave de Grafana no se imprime en el log.
cat > .env <<ENV
GRAFANA_ADMIN_PASSWORD=${grafana_password}
PROM_RETENTION_TIME=${retention_time}
PROM_RETENTION_SIZE=${retention_size}
ENV
chmod 600 .env
chmod -R a+rX grafana prometheus

# --- 3. Levantar el stack ----------------------------------------------------
docker compose up -d

# --- 4. Esperar a que Prometheus y Grafana respondan -------------------------
for i in $(seq 1 60); do
  if curl -fsS http://localhost:9090/-/ready >/dev/null 2>&1 \
     && curl -fsS http://localhost:3000/api/health >/dev/null 2>&1; then
    touch /var/lib/andys-monitoring-ready
    break
  fi
  sleep 5
done

echo "=== Stack de monitoreo de ${project_name} levantado ==="
docker compose ps
