{
  "uid": "andys-tecnico",
  "title": "AndysMotors | 1. Salud técnica de la plataforma",
  "description": "Método RED (Rate, Errors, Duration) por plataforma, estado del balanceador y recursos de infraestructura.",
  "tags": [
    "andysmotors",
    "ep2",
    "tecnico"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
