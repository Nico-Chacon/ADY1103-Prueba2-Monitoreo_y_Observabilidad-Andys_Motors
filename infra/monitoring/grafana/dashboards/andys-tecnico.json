  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Cómo leer este tablero",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Salud técnica de AndysMotors** (método RED + infraestructura). Cada fila responde una pregunta: ¿están arriba los componentes?, ¿cuánto tráfico y con qué errores/latencia?, ¿y los servidores y la base de datos soportan la carga?  \nColores: 🟢 normal · 🟠 atención · 🔴 acción inmediata. Ventana por defecto: 30 min, refresco 10 s."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Componentes monitoreados activos (UP)",
      "description": "Cantidad de targets que Prometheus logra recolectar correctamente (up = 1).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Componentes caídos (DOWN)",
      "description": "Targets que Prometheus NO logra recolectar (up = 0). Debe ser 0.",
