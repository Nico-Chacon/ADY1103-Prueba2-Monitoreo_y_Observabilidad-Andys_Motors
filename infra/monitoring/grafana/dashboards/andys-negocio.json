  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Cómo leer este tablero",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Negocio y continuidad operativa de AndysMotors.** Estas métricas solo las puede emitir la aplicación: un servicio puede responder 200/201 en milisegundos y aun así no estar concretando el negocio.  \nLas brechas *solicitados vs confirmados* y *creadas vs vinculadas* son el síntoma de las fallas silenciosas que CloudWatch no ve. 🟢 ≥ 99 % · 🟠 95–99 % · 🔴 < 95 %."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agendamientos confirmados (%)",
      "description": "SLI de negocio: de cada 100 visitas solicitadas, cuántas quedaron realmente registradas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(agendamientos_confirmados_total[5m])) / sum(rate(agendamientos_solicitados_total[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
