    {
      "id": 6,
      "type": "timeseries",
      "title": "Agendamientos: solicitados vs confirmados (por minuto)",
      "description": "Si la línea de confirmados se separa de la de solicitados, hay visitas que el cliente pidió y el sistema no guardó.",
